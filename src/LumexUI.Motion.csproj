<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<!-- .NET 8 and 9 reached end of support on 10 November 2026. Plural, so another framework can be added later. -->
		<TargetFrameworks>net10.0</TargetFrameworks>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>

	<PropertyGroup>
		<Title>LumexUI.Motion</Title>
		<Description>A Blazor wrapper for the Motion library.</Description>
		<Version>0.2.0</Version><!-- x-release-please-version -->
		<Authors>desmondinho;chrismeller</Authors>
		<PackageId>LumexUI.Motion</PackageId>
		<!--<PackageIcon>logo.png</PackageIcon>-->
		<PackageTags>blazor;motion;components;library;</PackageTags>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/chrismeller/lumexui-motion</PackageProjectUrl>
		<RepositoryUrl>https://github.com/chrismeller/lumexui-motion</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
	</PropertyGroup>

	<PropertyGroup>
		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\LICENSE" Pack="true" Visible="false" PackagePath="" />
		<None Include="..\README.md" Pack="true" Visible="false" PackagePath="" />
		<!--<None Include="..\assets\logo.png" Pack="true" Visible="false" PackagePath="" />-->
	</ItemGroup>

	<ItemGroup>
		<SupportedPlatform Include="browser" />
	</ItemGroup>

	<ItemGroup Condition=" '$(TargetFramework)' == 'net10.0' ">
		<PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.15" />
	</ItemGroup>

	<!--
		Bundles src/Scripts with the parts of `motion` it uses into wwwroot/motion.js, so the browser never fetches
		the library from a CDN. The bundle is generated, not committed, so building this project needs Node and
		pnpm (mise.toml). It runs before the build so the static web assets pick the file up.
	-->
	<PropertyGroup>
		<JsRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/..'))</JsRoot>
		<MotionBundle>wwwroot/motion.js</MotionBundle>
	</PropertyGroup>

	<Target Name="PnpmInstall" Condition="!Exists('$(JsRoot)/node_modules')">
		<Exec Command="pnpm install --frozen-lockfile" WorkingDirectory="$(JsRoot)" />
	</Target>

	<Target Name="BundleMotionCore"
			DependsOnTargets="PnpmInstall"
			Inputs="@(MotionScript);$(JsRoot)/package.json;$(JsRoot)/pnpm-lock.yaml;$(JsRoot)/rollup.config.js"
			Outputs="$(MotionBundle)">
		<Exec Command="pnpm build" WorkingDirectory="$(JsRoot)" />
	</Target>

	<!--
		Each target framework builds in parallel. Calling the bundle step on the project without a TargetFramework
		gives every inner build the same project instance, so MSBuild runs it once and the others wait for it.
	-->
	<Target Name="BundleMotion" BeforeTargets="BeforeBuild" Condition="'$(DesignTimeBuild)' != 'true'">
		<MSBuild Projects="$(MSBuildProjectFullPath)" Targets="BundleMotionCore" RemoveProperties="TargetFramework" />
	</Target>

	<!-- Make sure a bundle that didn't exist when the project was evaluated is still a static web asset. -->
	<Target Name="IncludeMotionBundle" AfterTargets="BundleMotion" Condition="'$(DesignTimeBuild)' != 'true'">
		<ItemGroup>
			<Content Remove="$(MotionBundle)" />
			<Content Include="$(MotionBundle)" />
		</ItemGroup>
	</Target>

	<ItemGroup>
		<MotionScript Include="Scripts/**/*.js" />
		<None Remove="Scripts/**" />
	</ItemGroup>

</Project>
